# Doc Recognition Integration Service
# Copy to repo root as .env or symlink; never commit real secrets.

# --- App ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
API_BEARER_TOKEN=change-me-1c-token

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docrec
POSTGRES_USER=docrec
POSTGRES_PASSWORD=docrec
DATABASE_URL=postgresql+asyncpg://docrec:docrec@localhost:5432/docrec

# --- Channel: max | telegram ---
# Pilot without foreign VPN/ngrok: use MAX + long polling
BOT_CHANNEL=max

# --- MAX (messenger) ---
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Comma-separated Max user_id; empty = allow all and print id on /start
MAX_WHITELIST_IDS=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_POLL_TIMEOUT=30
MAX_POLL_LIMIT=100

# --- Telegram (optional / legacy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated; MVP = one id
TELEGRAM_WHITELIST_IDS=
# Public HTTPS URL of tunnel (only if BOT_CHANNEL=telegram)
TELEGRAM_WEBHOOK_BASE_URL=

# --- Storage: yandex | local ---
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/packets

# Yandex Disk (personal 360 OAuth)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REFRESH_TOKEN=
YANDEX_DISK_ROOT=/incoming_invoices

# --- OCR ---
# stub | openai | grok | yandexgpt | anydoc
OCR_MODE=yandexgpt
# Yandex Cloud API key (NOT Disk OAuth) + folder id
YANDEX_CLOUD_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt/latest
YANDEX_OCR_MODEL=table
# ocr_gpt = Vision OCR → YandexGPT; vision = gemma multimodal
YANDEX_RECOGNIZE_MODE=ocr_gpt
YANDEX_VISION_MODEL=gemma-3-27b-it/latest
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_VISION_MODEL=grok-4
OCR_API_URL=
OCR_API_KEY=
FIRECRAWL_API_KEY=

# --- Worker ---
WORKER_POLL_SECONDS=2
WORKER_ID=worker-1
